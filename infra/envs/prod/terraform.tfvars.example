# Copy to terraform.tfvars (gitignored) for local runs.
# GitHub Actions does not read this file: it uses the variable defaults plus the
# repository variable TFVARS_PROD (JSON) and ACR_NAME. Keep both in sync.

# subscription_id = "00000000-0000-0000-0000-000000000000" # or export ARM_SUBSCRIPTION_ID
acr_name = "crimpactmapxxxxxx" # bootstrap output acr_name

# Sizing: the defaults for prod are the lean start (about USD 150-200 / month).
app_service_sku                       = "P0v3"
app_service_worker_count              = 1
staging_slot_enabled                  = true
frontdoor_sku                         = "Standard_AzureFrontDoor"
waf_mode                              = "Prevention"
postgres_sku                          = "B_Standard_B2s"
postgres_backup_retention_days        = 35
postgres_geo_redundant_backup_enabled = true
postgres_high_availability_enabled    = false

# Scale up later (about USD 950-1 050 / month), no code change needed:
# app_service_sku                    = "P1v3"
# app_service_worker_count           = 2
# frontdoor_sku                      = "Premium_AzureFrontDoor"  # managed WAF rule sets
# postgres_sku                       = "GP_Standard_D2ds_v5"
# postgres_high_availability_enabled = true                      # zone-redundant standby
# availability_test_frequency        = 300
# availability_test_locations        = ["emea-nl-ams-azr", "emea-gb-db3-azr", "us-va-ash-azr", "us-ca-sjc-azr", "apac-sg-sin-azr"]
log_retention_in_days                 = 90
log_daily_quota_gb                    = -1
log_level                             = "info"

# Optional extras (null = off)
# custom_domain = "impact-map.example.com"
# alert_email   = "you@example.com"
# budget_amount = 400
